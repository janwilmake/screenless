{
  // The API the CLI talks to: telephony, verification, call records, billing,
  // and the parked briefs the morning call is placed from.
  //
  // Deploy:  cd worker && npx wrangler deploy
  "name": "screenless",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "080fd9e0587416d2fa30ed1f527e2323",

  // The CLI's default endpoint. Kept on its own subdomain so the landing page
  // and the API can be deployed, rolled back, and rate-limited independently.
  "routes": [{ "pattern": "api.screenless.sh", "custom_domain": true }],

  "vars": {
    // The Telnyx number the call comes *from*. Must be a number you own.
    //
    // Currently a US number, because it has no regulatory requirements and
    // activates instantly. Fine while it only ever dials your own verified
    // phone, where the caller ID is cosmetic.
    //
    // Swap back to the NL number (+31850835195) once its regulatory review
    // clears: anonymous or foreign CLI is not acceptable for real NL outbound,
    // and the Amsterdam AnchorSite pairs with an NL origin.
    "TELNYX_FROM_NUMBER": "+16412153640",

    // Region each call's media is anchored to. Telnyx's EU GPUs are co-located
    // with the telephony PoPs in Amsterdam, which is the point of using Telnyx
    // for Dutch calls at all. Applied per call to the assistant's own TeXML
    // app, which would otherwise default to "Latency".
    "TELNYX_ANCHORSITE": "Amsterdam, Netherlands",

    // LLM driving the conversation. Telnyx hosts several; Haiku is fast and
    // cheap, which matters because time-to-first-token is the largest single
    // slice of per-turn latency.
    "ASSISTANT_MODEL": "anthropic/claude-haiku-4-5",

    // Normally empty: the voice follows the caller's chosen language, from the
    // table in src/languages.ts. Set this only to force one voice everywhere.
    "ASSISTANT_VOICE": "",

    // Worldwide. The real spend guard is BLOCKED_PREFIXES in src/index.ts,
    // which blocks satellite and SMS-pumping ranges regardless of this value.
    // Narrow to a comma-separated list of ISO codes ("NL,BE,DE") to restrict.
    "ALLOWED_DESTINATIONS": "US,CA,NL,BE,GB,IE,DE,AT,CH,FR,ES,PT,IT,SE,NO,DK,FI,PL,CZ,LU,IN,JP,BR,MX,AU,NZ,ZA,SG",

    // Sender for the edition and for confirmation codes.
    //
    // hello@ rather than press@ because this address can also *receive*:
    // Cloudflare Email Routing forwards it to a real mailbox. A From address
    // that bounces is bad manners — someone replies to the paper and it
    // vanishes — and a mildly negative signal to spam filters besides.
    //
    // Deliverability does not depend on the local part at all: Resend verifies
    // the domain, and DKIM signs for screenless.sh however the mailbox is
    // named. press@ can come back the moment it has a routing rule.
    "MAIL_FROM": "screenless <hello@screenless.sh>",

    // Default recipient, so the nightly loop needs no --to. Leave empty to
    // require --to on every send.
    "MAIL_TO": "",

    // Where Checkout sends people when they finish or bail. Also the return
    // target from the billing portal.
    "SITE_URL": "https://screenless.sh",

    // This Worker's own hostname. Used to build Telnyx callback URLs from the
    // cron sweep, which — unlike a fetch — has no request to read it from.
    "API_HOST": "api.screenless.sh",

    // The recurring price the 7-day trial converts to. Leave empty and the
    // Worker inlines $99/month at Checkout instead — the paywall works either
    // way, but a real price id is what makes Stripe's revenue reporting mean
    // anything.
    //
    // TEST MODE. $99/month on product prod_V4pc9EmdyrVtBH. Going live means a
    // live-mode product, price, and webhook, then swapping this id along with
    // STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET — no code changes.
    "STRIPE_PRICE_ID": "price_1U4fwvCL0Yranfl4MDErDZbh"
  },

  // Stores call records, settings, subscriptions, parked briefs, and OTP
  // rate-limit counters.
  // Create with: wrangler kv namespace create CALLS
  "kv_namespaces": [{ "binding": "CALLS", "id": "1f4267f254c74f82a24737a84070f991" }],

  // Places any brief whose call time has come. Five minutes is well inside
  // what a caller perceives — a call at 08:03 is a call at eight.
  "triggers": { "crons": ["*/5 * * * *"] }

  // Secrets (never put these here — use `wrangler secret put NAME`):
  //   TELNYX_API_KEY
  //   TELNYX_VERIFY_PROFILE_ID
  //   SESSION_SECRET
  //   ADMIN_SECRET
  //   STRIPE_SECRET_KEY     — while unset, every verified number is entitled
  //   STRIPE_WEBHOOK_SECRET — from `stripe webhook_endpoints create`
  //   RESEND_API_KEY        — sends the nightly edition
}
